{
  "signer": {
    "type": "inmemory",
    "key": "env(RANKE_SIGNER_KEY)"
  },
  "storage": {
    "type": "stack",
    "layers": [
      {
        "type": "mem"
      }
    ]
  },
  "sequencer": {
    "type": "dev",
    "history": {
      "type": "mem"
    }
  },
  "accounts": {
    "ops": {
      "grants": [
        "CR *",
        "C $branches",
        "R $archive"
      ]
    }
  },
  "endpoints": [
    {
      "transport": {
        "type": "rest",
        "addr": ":8080"
      },
      "auth": [
        {
          "type": "noauth",
          "subject": "ops"
        }
      ],
      "admit": [
        "ops"
      ]
    }
  ]
}
